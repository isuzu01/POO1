@model IEnumerable<POO1_T2_Parte02_TrujilloMezaJhuli.Models.Veterinario>

@{
    ViewBag.Title = "Index";
}

<h2>Lista de Veterinarios</h2>

<p>
    @Html.ActionLink("Agregar veterinario", "Agregar") | 
    @Html.ActionLink("Serializar", "Serializar")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Id_Veterinario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre_Veterinario)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Especialidad)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Telefono)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id_Veterinario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre_Veterinario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Especialidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.ActionLink("Eliminar", "Eliminar", new { id = item.Id_Veterinario })
            </td>
        </tr>
    }

</table>

@if (ViewBag.Message != null)
{
    <p>@ViewBag.Message</p>
}